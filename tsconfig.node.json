{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "scraper/**/*.ts",
    "src/lib/snapshot/**/*.ts",
    "src/lib/core/**/*.ts",
    "src/**/*.test.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "eslint.config.js"
  ]
}
